{
  "name": "tierrechtskongress-leipzig",
  "version": "1.0.0",
  "description": "Static Eleventy site for the Tierrechtskongress Leipzig.",
  "main": "index.js",
  "scripts": {
    "start": "npm run dev",
    "test": "npm run test:e2e",
    "clean": "rimraf ${ELEVENTY_OUTPUT_DIR:-output/site}",
    "eleventy:default": "npx eleventy",
    "eleventy:watch": "npx eleventy --watch",
    "styles:dev": "sass ./src/assets/sass/:${ELEVENTY_OUTPUT_DIR:-output/site}/assets/css/ --source-map && postcss ${ELEVENTY_OUTPUT_DIR:-output/site}/assets/css/*.css --replace",
    "styles:prod": "sass ./src/assets/sass/:${ELEVENTY_OUTPUT_DIR:-output/site}/assets/css/ --style compressed && postcss ${ELEVENTY_OUTPUT_DIR:-output/site}/assets/css/*.css --replace",
    "serve": "light-server -c .lightserverrc",
    "dev": "ELEVENTY_OUTPUT_DIR=output/site npm-run-all clean styles:dev eleventy:default --parallel eleventy:watch serve --print-label",
    "dev:debug": "DEBUG=* npm run dev",
    "build:site": "ELEVENTY_OUTPUT_DIR=output/site run-s clean styles:prod eleventy:default --print-label",
    "build": "npm run build:site",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tierrechtskongress/trk26.git"
  },
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://tierrechtskongress.org/",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@playwright/test": "^1.58.2",
    "autoprefixer": "^10.4.27",
    "light-server": "2.9.1",
    "postcss": "^8.5.8",
    "postcss-cli": "^11.0.1",
    "sass": "^1.98.0"
  },
  "dependencies": {
    "cssnano": "^7.1.3",
    "npm-run-all": "^4.1.5",
    "rimraf": "6.1.3"
  }
}
