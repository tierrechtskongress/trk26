{
  "name": "tierrechtskongress-leipzig",
  "version": "1.0.0",
  "description": "Static Eleventy site for the Tierrechtskongress Leipzig.",
  "scripts": {
    "start": "npm run dev",
    "test": "npm run test:e2e",
    "clean": "rimraf ${ELEVENTY_OUTPUT_DIR:-output/site}",
    "eleventy": "npx eleventy",
    "eleventy:watch": "npx eleventy --watch",
    "styles:dev": "sass ./src/assets/sass/:${ELEVENTY_OUTPUT_DIR:-output/site}/assets/css/ --source-map && postcss ${ELEVENTY_OUTPUT_DIR:-output/site}/assets/css/*.css --replace",
    "styles:prod": "sass ./src/assets/sass/:${ELEVENTY_OUTPUT_DIR:-output/site}/assets/css/ --style compressed && postcss ${ELEVENTY_OUTPUT_DIR:-output/site}/assets/css/*.css --replace",
    "serve": "light-server -c .lightserverrc",
    "dev": "ELEVENTY_OUTPUT_DIR=output/site run-s clean styles:dev eleventy && ELEVENTY_OUTPUT_DIR=output/site run-p eleventy:watch serve",
    "build": "ELEVENTY_OUTPUT_DIR=output/site run-s clean styles:prod eleventy",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "check:ci": "npm run format:check && npm run build && npm run test:e2e",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:e2e": "playwright test",
    "test:e2e:prod-smoke": "playwright test --config=playwright.prod.config.ts",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tierrechtskongress/trk26.git"
  },
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://tierrechtskongress.org/",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "autoprefixer": "^10.5.4",
    "cssnano": "^8.0.2",
    "light-server": "2.9.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.25",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.9.6",
    "rimraf": "6.1.3",
    "sass": "^1.102.0"
  }
}
