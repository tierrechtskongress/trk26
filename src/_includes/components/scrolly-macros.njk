{% macro scrolly(steps, images) %}
{% for step in steps %}
{% if loop.first %}
{% if step.heading or step.text %}
<div class="scrolly-step-card scrolly-intro-card">
  {% if step.heading %}<h2>{{ step.heading | safe }}</h2>{% endif %}
  <div class="scrolly-text">{{ step.text | cmsBlock | safe }}</div>
</div>
{% endif %}
<div class="scrolly-stack">
  <div class="scrolly-bg-column">
    {% for img in images %}
    <div class="scrolly-bg-image" style="background-image: url('{{ img }}');"></div>
    {% endfor %}
  </div>
  <div class="scrolly-overlay-steps">
{% else %}
    <div class="scrolly-step-card">
      {% if step.heading %}<h2>{{ step.heading | safe }}</h2>{% endif %}
      <div class="scrolly-text">{{ step.text | cmsBlock | safe }}</div>
    </div>
{% endif %}
{% if loop.last %}
  </div>
</div>
{% endif %}
{% endfor %}
{% endmacro %}