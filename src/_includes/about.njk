---
layout: layouts/base.njk
---
{% from 'components/congress-macros.njk' import sectionBanner, aboutTeamMember %}
<div class="page-shell">
<div id="about" class="anchor-section">
{{ sectionBanner(site.congress.about.title) }}

<div class="scrolly-step-card">
{% for paragraph in site.congress.about.mission %}
<p>{{ paragraph | cmsBlock | safe }}</p>
{% endfor %}
</div>

<div class="about-team-grid">
{% for member in site.congress.about.team %}
{{ aboutTeamMember(member, site.ui) }}
{% endfor %}
</div>
</div>
</div>