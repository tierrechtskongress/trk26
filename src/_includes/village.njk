---
layout: layouts/base.njk
---
{% from 'components/scrolly-macros.njk' import scrolly %}
{% from 'components/congress-macros.njk' import sectionBanner %}
{% set steps = site.congress.framework.items | scrollySteps("", site.congress.framework.introText) %}
<div class="page-shell">
<div id="rahmenprogramm" class="anchor-section">
    {{ sectionBanner(site.congress.framework.title) }}
    {{ scrolly(
        steps,
        [
            "/images/hero/village/village1.jpg" | url,
            "/images/hero/village/village2.jpg" | url
        ]
    ) }}
</div>
</div>