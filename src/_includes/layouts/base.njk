<html lang="{{ site.locale or 'de' }}">
    <head>
        <title>{{ site.title }} | {{ site.siteName }}</title>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
        <link rel="alternate" hreflang="de" href="{{ '/' | url }}" />
        <link rel="alternate" hreflang="en" href="{{ '/en/' | url }}" />
        <link rel="stylesheet" href="{{ '/assets/css/fontawesome-all.min.css' | url }}" />
        <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}" />
        <link rel="stylesheet" href="{{ '/assets/css/custom.css' | url }}" />
    </head>
    <body class="is-preload{% if site.bodyClass %} {{ site.bodyClass }}{% endif %}">
        <div id="wrapper">
            <header class="site-sticky-nav">
                {% include 'navigation.njk' %}
            </header>
            {% include 'header.njk' %}

            <main id="main">
                {{ content | safe }}
            </main>

            {% include 'scripts.njk' %}
        </div>
    </body>
</html>